# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:
# MONGO_URI=mongodb://127.0.0.1:27017/readymade
# Atlas:
MONGO_URI=mongodb+srv://ReadyMade:<db_password>@readymade.wgolzbt.mongodb.net/readymade?retryWrites=true&w=majority&appName=ReadyMade

# If you see DNS errors like `queryTxt EREFUSED <cluster>.mongodb.net`, your network/DNS is blocking SRV/TXT.
# In that case, use the "Standard connection string" from Atlas (mongodb://... with host list + tls=true).

# Auth
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
